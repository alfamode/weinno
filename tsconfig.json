{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node16",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@data/*": ["./data/*"],
      "@utils": ["./utils/utils.ts"],
      "@fixtures/*": ["./fixtures/*"],
      "@helpers/*": ["./helpers/*"],
      "@pages/*": ["./pages/*"],
      "@playwright/*": ["./node_modules/playwright/*"],
    }
  }
}